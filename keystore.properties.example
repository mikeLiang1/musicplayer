# Copy this file to "keystore.properties" (which is git-ignored) and fill in
# your release signing credentials. When keystore.properties is absent the
# release build falls back to the debug signing key so it still assembles
# locally for testing.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias musicplayer

storeFile=release.jks
storePassword=changeit
keyAlias=musicplayer
keyPassword=changeit
